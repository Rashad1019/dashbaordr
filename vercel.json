{
  "routes": [
    {
      "src": "/api/news",
      "dest": "/api/news.py"
    },
    {
      "src": "/api/summarize",
      "dest": "/api/summarize.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(index\\.html|style\\.css|agents\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}
